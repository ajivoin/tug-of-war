# Copy to .env and fill in a real bot token.
# See https://discord.com/developers/applications/
DISCORD_TOKEN=your-bot-token-here

# Command prefix. Optional, defaults to t?
PREFIX=t?

# Path to the persisted game state. Optional, defaults to data.json in the
# working directory. In Docker, point this at a mounted volume.
# DATA_FILE=/data/data.json
